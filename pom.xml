<project>
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.janinduc</groupId>
    <artifactId>wonder-insight</artifactId>
    <version>1.17.2</version>
    <packaging>jar</packaging>
    <name>Wonder Insight</name>
    <description>A Spring Boot library for insight and monitoring</description>
    <url>https://github.com/JaninduC/wonder-insight</url>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>JaninduC</name>
            <url>https://github.com/JaninduC</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/JaninduC/wonder-insight.git</connection>
        <developerConnection>scm:git:ssh://github.com:JaninduC/wonder-insight.git</developerConnection>
        <url>https://github.com/JaninduC/wonder-insight</url>
    </scm>
    <properties>
        <java.version>17</java.version>
        <spring.boot.version>3.4.4</spring.boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Required for filter + exceptions -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
            <version>1.40.0</version>
        </dependency>
        <!-- For auto-configuration -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

<!--    <distributionManagement>-->
